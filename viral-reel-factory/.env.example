# Copy to .env and fill in ONE provider key. .env is git-ignored; keys never leave the server.
# Without a key the app runs in Demo Mode (built-in offline engine).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional:
# AI_PROVIDER=        # gemini | openai | demo (auto-detected from the key when omitted)
# GEMINI_MODEL=       # default: gemini-3.8-flash
# OPENAI_MODEL=       # default: gpt-4o-mini
# OPENAI_BASE_URL=    # any OpenAI-compatible endpoint
# PORT=3000
