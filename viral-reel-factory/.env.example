# Without keys the app runs in Demo Mode (offline story engine). Keys stay on the server.
# AI_PROVIDER=openai   # openai | gemini | demo (auto-detected from keys when omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
