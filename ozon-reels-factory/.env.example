# Without keys the app runs in Demo Mode. Keys stay on the server and never reach the browser.
# AI_PROVIDER=openai   # openai | gemini | demo (auto-detected from keys when omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded (HTTP 429/5xx) or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
PORT=3000
